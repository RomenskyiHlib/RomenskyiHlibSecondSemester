<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Калькулятор" Height="600" Width="400" Background="LightSlateGray">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="140*"/>
            <RowDefinition Height="98*"/>
            <RowDefinition Height="98*"/>
            <RowDefinition Height="98*"/>
            <RowDefinition Height="98*"/>
            <RowDefinition Height="98*"/>
        </Grid.RowDefinitions>
        <Rectangle x:Name="BgButtons_Copy" Fill="DarkOrange" Grid.ColumnSpan="4" Margin="0,0,0,109" Grid.RowSpan="2"/>
        <Rectangle x:Name="BgLabel" Fill="White"  Grid.Row="1" Grid.ColumnSpan="4" Margin="5,20,5,15"/>
        <Rectangle x:Name="BgButtons" Fill="DarkOrange"  Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="6" Margin="0,109,0,0"/>
        <Button x:Name="CE" Content="CE" Grid.Column="0" Grid.Row="2" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,5" Click="CE_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="C" Content="C" Grid.Column="1" Grid.Row="2" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,5" Click="C_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="lt" Content="&lt;" Grid.Column="2" Grid.Row="2" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,5" Click="lt_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Slash" Content="/" Grid.Column="3" Grid.Row="2" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,5" Click="Slash_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Nine" Content="9" Grid.Row="3" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,3,5,3" Grid.Column="2" Click="Nine_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Eight" Content="8" Grid.Row="3" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,2,5,3" Grid.Column="1" Click="Eight_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Seven" Content="7" Grid.Row="3" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,4" Click="Seven_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Six" Content="6" Grid.Row="4" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,5,5,3" Grid.Column="2" Click="Six_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Five" Content="5" Grid.Row="4" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,3" Grid.Column="1" Click="Five_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Four" Content="4" Grid.Row="4" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,4" Click="Four_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Three" Content="3" Grid.Row="5" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,4" Grid.Column="2" Click="Three_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Two" Content="2" Grid.Row="5" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,4" Grid.Column="1" Click="Two_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Zero" Content="0" Grid.Row="6" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,4" Grid.Column="1" Click="Zero_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="One" Content="1" Grid.Row="5" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,4" Click="One_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Multiply" Content="*" Grid.Column="3" Grid.Row="3" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,3,5,4" Click="Multiply_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Subtrack" Content="-" Grid.Column="3" Grid.Row="4" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,3,5,4" Click="Subtrack_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Button x:Name="Add" Content="+" Grid.Column="3" Grid.Row="5" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,3,5,4" Click="Add_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Dot" Content="." Grid.Row="6" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,3" Click="Dot_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="Equal" Content="=" Grid.Row="6" FontSize="50" FontFamily="Consolas" Foreground="White" Margin="5,4,5,4" Grid.Column="2" Grid.ColumnSpan="2" Click="Equal_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="0.0" />
                    <GradientStop Color="DarkSlateGray" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Label x:Name="Operations" Grid.ColumnSpan="4" Margin="0,15,0,15" Grid.Row="1" FontSize="45" FontFamily="Consolas" BorderBrush="DimGray"  BorderThickness="6" HorizontalContentAlignment="Right"/>
        <Label x:Name="LastOperations" Grid.ColumnSpan="4" Margin="19,10,17,119" FontSize="20" FontFamily="Consolas" HorizontalContentAlignment="Right" Foreground="DimGray" Grid.RowSpan="2"/>

    </Grid>
</Window>
