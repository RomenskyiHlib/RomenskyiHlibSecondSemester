<Window x:Class="SeventhLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeventhLab"
        mc:Ignorable="d"
        Title="Login" Height="500" Width="800" Background="{StaticResource gradientBgStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        <Rectangle Name="Bg" Grid.Row="1" Grid.Column="1" Grid.RowSpan="4" Grid.ColumnSpan="6" Fill="{StaticResource BgStyle}"/>
        <Rectangle Name="Border" Grid.Row="1" Grid.Column="1" Grid.RowSpan="4" Grid.ColumnSpan="6" Fill="Transparent" Stroke="{StaticResource gradientStyle}" StrokeThickness="7"/>
        <Grid Name="Buttons" Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="0.7*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="0.7*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="0.4*"/>
                <RowDefinition/>
                <RowDefinition Height="0.3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Name="LoginText" Grid.ColumnSpan="6" Text="LOGIN" Foreground="{StaticResource gradientHeadingsStyle}" HorizontalAlignment="Center" FontSize="30" FontFamily="Berlin Sans FB"/>
            <TextBlock Name="UsernameText" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Text="Username:" Foreground="White" FontSize="16" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <TextBox Name="UsernameBox" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="2" Foreground="Black" FontSize="16" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <TextBlock Name="PasswordText" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Text="Password:" Foreground="White" FontSize="16" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <PasswordBox Name="PasswordBox" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="4" Foreground="Black" FontSize="16" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <Button Name="LoginButton" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="6" Content="LOGIN" Foreground="White" Background="{StaticResource gradientBigButtonStyle}" HorizontalAlignment="Center" FontSize="20" FontFamily="Berlin Sans FB" Width="203" Height="30" Click="LoginButton_Click"/>
            <Button Name="ForgotPasswordButton" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="5" Content="Forgot password?" Foreground="LightGray" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" FontFamily="Berlin Sans FB" Background="Transparent" BorderBrush="Transparent" Click="ForgotPasswordButton_Click"/>
            <Button Name="BlueSkyLogo" Grid.Column="2" Grid.Row="8" Foreground="White" Background="Transparent" BorderBrush="Transparent" Click="BlueSkyLogo_Click">
                <Image Source="Images/bslogo.png" Width="35" Height="36"/>
            </Button>
            <Button Name="GoogleLogo" Grid.Column="3" Grid.Row="8" Foreground="White" Background="Transparent" BorderBrush="Transparent" Click="GoogleLogo_Click">
                <Image Source="Images/glogo.png" Width="36" Height="36"/>
            </Button>
            <TextBlock Name="OrSingUpUsing" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="7" Text="Or Sing Up Using" Foreground="White" FontSize="9" FontFamily="Berlin Sans FB" TextAlignment="Center"  VerticalAlignment="Center"/>
        </Grid>
        <Grid Name="Info" Grid.Row="2" Grid.Column="4" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.3*"/>
            </Grid.RowDefinitions>

            <Image Source="/Images/Icon1.png" Stretch="Uniform" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Name="InfoText" Grid.Row="1" Grid.Column="1" Text="Have not account yet?" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontFamily="Berlin Sans FB"/>
            <Button Name="SignUpButton" Grid.Column="1" Grid.Row="3" Content="SIGN UP" Foreground="{StaticResource gradientHeadingsStyle}" Background="Transparent" HorizontalAlignment="Center" FontSize="21" FontFamily="Berlin Sans FB" Width="203" BorderBrush="Transparent" Click="SignUpButton_Click"/>
        </Grid>
    </Grid>
</Window>
