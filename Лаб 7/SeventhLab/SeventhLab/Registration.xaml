<Window x:Class="SeventhLab.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeventhLab"
        mc:Ignorable="d"
               Title="Registration" Height="500" Width="800" Background="{StaticResource gradientBgStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        <Rectangle Name="BgReg" Grid.Row="1" Grid.Column="1" Grid.RowSpan="4" Grid.ColumnSpan="6" Fill="{StaticResource BgStyle}"/>
        <Rectangle Name="BorderReg" Grid.Row="1" Grid.Column="1" Grid.RowSpan="4" Grid.ColumnSpan="6" Fill="Transparent" Stroke="{StaticResource gradientStyle}" StrokeThickness="7"/>
        <Grid Name="ButtonsReg" Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1.6*"/>
                <RowDefinition Height="0.8*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="0.7*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="0.8*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="0.8*"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="0.9*"/>
                <RowDefinition Height="1.3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Name="RegText" Grid.ColumnSpan="6" Text="REGISTRATION" Foreground="{StaticResource gradientHeadingsStyle}" HorizontalAlignment="Center" FontSize="28" FontFamily="Berlin Sans FB"/>
            <TextBlock Name="UsernameTextReg" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Text="Username:" Foreground="White" FontSize="15" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <TextBox Name="UsernameBoxReg" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="2" Foreground="Black" FontSize="16" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/> 
            <TextBlock Name="EmailTextReg" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Text="Email:" Foreground="White" FontSize="15" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <TextBox Name="EmailBoxReg" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="4" Foreground="Black" FontSize="16" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <TextBlock Name="PasswordTextReg" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="5" Text="Password:" Foreground="White" FontSize="15" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <PasswordBox Name="PasswordBox" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="6" Foreground="Black" FontSize="16" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <TextBlock Name="PasswordConfimTextReg" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="7" Text="Confirm Password:" Foreground="White" FontSize="15" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <PasswordBox Name="PasswordConfimBox" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="8" Foreground="Black" FontSize="16" FontFamily="Berlin Sans FB" VerticalAlignment="Center"/>
            <Button Name="RegButton" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="10" Content="REGISTER" Foreground="White" Background="{StaticResource gradientBigButtonStyle}" HorizontalAlignment="Center" FontSize="20" FontFamily="Berlin Sans FB" Width="203" Height="30" Click="RegButton_Click"/>
        </Grid>
        <Grid Name="InfoReg" Grid.Row="2" Grid.Column="4" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.3*"/>
            </Grid.RowDefinitions>
            <Image Source="/Images/Icon2.png" Stretch="Uniform" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Name="InfoTextReg" Grid.Row="1" Grid.Column="1" Text="Do you have an account?" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontFamily="Berlin Sans FB"/>
            <Button Name="logInButton" Grid.Column="1" Grid.Row="3" Content="LOG IN" Foreground="{StaticResource gradientHeadingsStyle}" Background="Transparent" HorizontalAlignment="Center" FontSize="21" FontFamily="Berlin Sans FB" Width="203" BorderBrush="Transparent" Click="logInButton_Click"/>
        </Grid>
    </Grid>
</Window>
