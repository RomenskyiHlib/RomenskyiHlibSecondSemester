<Application x:Class="SeventhLab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SeventhLab"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="gradientStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="Purple" Offset="0" />
            <GradientStop Color="HotPink" Offset="0.5" />
            <GradientStop Color="MediumPurple" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="gradientBgStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="DarkSlateBlue" Offset="0" />
            <GradientStop Color="#0d0c08" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BgStyle" Color="#212a4f"/>
        <LinearGradientBrush x:Key="gradientHeadingsStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="LightPink" Offset="0" />
            <GradientStop Color="HotPink" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="gradientBigButtonStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="DeepPink" Offset="0" />
            <GradientStop Color="HotPink" Offset="1" />
        </LinearGradientBrush>
        
    </Application.Resources>
</Application>
