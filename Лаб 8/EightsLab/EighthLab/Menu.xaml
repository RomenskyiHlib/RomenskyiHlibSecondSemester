<Window x:Class="EighthLab.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EighthLab"
        mc:Ignorable="d"
        Title="Menu" Height="650" Width="850">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.3*"/>
            <RowDefinition/>
            
            <RowDefinition Height="2*"/>
            <RowDefinition/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        <Image Source="/Images/bg.png" Stretch="Fill" Grid.RowSpan="5" Grid.ColumnSpan="7"/>
        <Rectangle Name="Bg" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Grid.RowSpan="3" Fill="{StaticResource BgStyle}" Stroke="{StaticResource gradientBorderStyle}" StrokeThickness="5"/>
        <ListView Name="CandidatesTable" IsHitTestVisible="True" SelectionMode="Single" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Grid.RowSpan="2" Width="540" Height="340">
            
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="П.І.П." DisplayMemberBinding="{Binding FullName}" Width="120"/>
                    <GridViewColumn Header="Рік нар." DisplayMemberBinding="{Binding BirthYear}" Width="60"/>
                    <GridViewColumn Header="Освіта" DisplayMemberBinding="{Binding Education}" Width="100"/>
                    <GridViewColumn Header="Знання мов" DisplayMemberBinding="{Binding ForeignLanguages}" Width="100"/>
                    <GridViewColumn Header="Стаж (р.)" DisplayMemberBinding="{Binding ExperienceYears}" Width="60"/>
                    <GridViewColumn Header="ПК" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding ComputerSkills}" IsEnabled="False" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Реком." Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Recommendations}" IsEnabled="False" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Rectangle Name="Bg2" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Grid.RowSpan="3" Fill="{StaticResource gradientBG2Style}" Stroke="{StaticResource gradientBorderStyle}" StrokeThickness="5"/>
        <TextBlock Name="Filter" FontSize="26" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{StaticResource gradientBorderStyle}" Margin="0 0 -3 0">
        Фільтрація<LineBreak/>(За освітою)
        </TextBlock>

        <TextBlock Name="FustText" FontSize="24" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{StaticResource gradientBTextStyle}" Margin="0 -16 -2 0" FontFamily="Consolas" FontStyle="Italic">
Конкурс<LineBreak/>на заміщення<LineBreak/>вакантної<LineBreak/>посади
        </TextBlock>
        <Button Name="Add" Content="Додати" Grid.Column="1" Grid.Row="3" Height="60" Width="150" FontSize="21" Click="Add_Click" Background="{StaticResource gradientBorderStyle}" FontFamily="Century Gothic"/>
        <Button Name="Edit" Content="Редагування" Grid.Column="2" Grid.Row="3" Height="60" Width="150" FontSize="21" Click="Edit_Click" Background="{StaticResource gradientBorderStyle}" FontFamily="Century Gothic"/>
        <Button Name="Delete" Content="Видалити" Grid.Column="3" Grid.Row="3" Height="60" Width="150" FontSize="21" Click="Delete_Click" Background="{StaticResource gradientBorderStyle}" FontFamily="Century Gothic"/>
       
        <StackPanel Name="EducationList" Grid.Row="2" Grid.Column="4" Margin="5">
            <TextBlock Name="HighEduc" Text="Вища" FontSize="18" Margin="5" Foreground="White" FontFamily="Century Gothic"/>
            <TextBlock Name="MiddleEducSpecial" Text="Середня с." FontSize="18" Margin="5" Foreground="White" FontFamily="Century Gothic"/>
            <TextBlock Name="MiddleEduc" Text="Середня" FontSize="18" Margin="5" Foreground="White" FontFamily="Century Gothic"/>
            <TextBlock Name="All" Text="Усі" FontSize="18" Margin="5" Foreground="White" FontFamily="Century Gothic"/>
        </StackPanel>
        <StackPanel Name="RadioEducationList" Grid.Row="2" Grid.Column="5" Margin="5">
            <RadioButton Name="HighEducRB" Content="Вища" Margin="10" Checked="RadioButton_Checked"/>
            <RadioButton Name="MiddleEducSpecialRB" Content="Середня спеціальна" Margin="10" Checked="RadioButton_Checked"/>
            <RadioButton Name="MiddleEducRB" Content="Середня" Margin="10" Checked="RadioButton_Checked"/>
            <RadioButton Name="AllRB" Content="Усі" Margin="10" Checked="RadioButton_Checked"/>
        </StackPanel>

    </Grid>
</Window>
