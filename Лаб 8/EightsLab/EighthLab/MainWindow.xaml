<Window x:Class="EighthLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EighthLab"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="600" Background="AliceBlue">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <Image Source="/Images/bg.png" Stretch="Fill" Grid.RowSpan="12" Grid.ColumnSpan="6"/>
        <Rectangle Name="Bg" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Grid.RowSpan="10" Fill="{StaticResource BgStyle}" Stroke="{StaticResource gradientBorderStyle}" StrokeThickness="5"/>
        <TextBlock Name="CandidateCard" Text="Картка кандидата" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Foreground="{StaticResource gradientBorderStyle}"/>
        <TextBlock Name="PIP" Text="П.І.П." Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic"/>
        <TextBlock Name="Date" Text="Рік народження" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic"/>
        <TextBlock Name="Education" Text="Освіта" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic"/>
        <TextBlock Name="LangKnowledge" Text="Знання іноземних мов" Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic"/>
        <TextBlock Name="Career" Text="Стаж роботи" Grid.Row="7" Grid.Column="2" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic"/>
        <TextBlock Name="UsingComp" Text="Володію комп’ютером" Grid.Row="8" Grid.Column="2" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic"/>
        <TextBlock Name="Recom" Text="Наявність рекомендацій" Grid.Row="9" Grid.Column="2" VerticalAlignment="Center" FontSize="17" Foreground="White" FontFamily="Century Gothic"/>
        <TextBox Name="PIPbox" Text="{Binding Path = FullName}" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black"/>
        <TextBox Name="Datebox" Text="{Binding Path = BirthYear}" Grid.Row="4" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black"/>
        <ComboBox x:Name="Educbox" SelectedValue="{Binding Path = Education, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Grid.Row="5" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black">
            <ComboBoxItem Content="Вища"/>
            <ComboBoxItem Content="Середня спеціальна"/>
            <ComboBoxItem Content="Середня"/>
        </ComboBox>
        <TextBox Name="Langbox" Text="{Binding Path = ForeignLanguages}" Grid.Row="6" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black"/>
        <TextBox Name="Careerbox" Text="{Binding Path = ExperienceYears}" Grid.Row="7" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black"/>
        <CheckBox Name="CompCheck" IsChecked="{Binding Path = ComputerSkills}"  Grid.Row="8" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <CheckBox Name="RecomCheck" IsChecked="{Binding Path = Recommendations}" Grid.Row="9" Grid.Column="3"  VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,17"/>
        <Button Name="Add" IsDefault="True" Content="Додати" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="10" Width="200" Height="24" FontSize="16" Click="Add_Click" Foreground="DarkSlateBlue" VerticalContentAlignment="Center" Background="{StaticResource gradientBorderStyle}" FontFamily="Century Gothic"/>
        
    </Grid>
</Window>
