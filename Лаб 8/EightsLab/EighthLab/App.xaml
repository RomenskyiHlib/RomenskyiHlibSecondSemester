<Application x:Class="EighthLab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EighthLab"
             StartupUri="Menu.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="gradientBorderStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="Orange" Offset="0" />
            <GradientStop Color="Yellow" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BgStyle" Color="DarkSlateBlue"/>
        <LinearGradientBrush x:Key="gradientBTextStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="AliceBlue" Offset="0" />
            <GradientStop Color="LightBlue" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="gradientBG2Style" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="#301934" Offset="0" />
            <GradientStop Color="#310062" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>
</Application>
