<Window x:Class="NinthLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NinthLab"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600" Background="{StaticResource gradientBGStyle}" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="24*"/>
            <RowDefinition Height="49*"/>
            
            <RowDefinition Height="49*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="15*"/>
 
            <RowDefinition Height="49*"/>
            <RowDefinition Height="24*"/>
        </Grid.RowDefinitions>
        <Rectangle Name="Bg" Grid.ColumnSpan="6" Grid.RowSpan="9" Fill="{StaticResource gradientBG2Style}" Stroke="{StaticResource gradientBorderStyle}" StrokeThickness="5" Margin="35,24,35,24"/>
        <TextBlock Name="FormUser" Text="Форма користувача" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="35" Foreground="{StaticResource gradientBTextStyle}" FontWeight="Bold"/>
        <TextBlock Name="Firstname" Text="Ім'я" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic" Grid.ColumnSpan="2" Margin="53,0,0,0"/>
        <TextBlock Name="Lastname" Text="Прізвище" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic" Grid.ColumnSpan="2" Margin="53,0,0,0"/>
        <TextBlock Name="Gender" Text="Стать" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic" Grid.ColumnSpan="2" Margin="53,0,0,0"/>
        <TextBlock Name="Age" Text="Вік" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="Century Gothic" Grid.ColumnSpan="2" Margin="53,0,0,0"/>
        <TextBox Name="PIPbox" Text="{Binding Path = CurrentUser.FirstName}" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black" Grid.ColumnSpan="2" Margin="0,0,53,0"/>
        <TextBox Name="Datebox" Text="{Binding Path = CurrentUser.LastName}" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black" Grid.ColumnSpan="2" Margin="0,0,53,0"/>
        <ComboBox x:Name="Educbox" SelectedValue="{Binding Path = CurrentUser.Gender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Grid.Row="4" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black" Grid.ColumnSpan="2" Margin="0,0,53,0">
            <ComboBoxItem Content="Чоловіча"/>
            <ComboBoxItem Content="Жіноча"/>
            <ComboBoxItem Content="Не хочу вказувати"/>
        </ComboBox>
        <TextBox Name="AgeBox" Text="{Binding Path = CurrentUser.Age}" Grid.Row="5" Grid.Column="3" VerticalAlignment="Center" FontSize="18" BorderBrush="Black" Grid.ColumnSpan="2" Margin="0,0,53,0"/>
        <Button Name="Add" IsDefault="True" Content="Додати" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="7" Width="200" Height="44" FontSize="25" Foreground="DarkSlateBlue" VerticalContentAlignment="Center" Background="{StaticResource gradientBorderStyle}" FontFamily="Century Gothic" Click="Add_Click"/>
    </Grid>
</Window>