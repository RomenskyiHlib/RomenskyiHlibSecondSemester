<Application x:Class="NinthLab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NinthLab"
             StartupUri="Menu.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="gradientBorderStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="Cyan" Offset="0" />
            <GradientStop Color="LightBlue" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BgStyle" Color="AliceBlue"/>
        <LinearGradientBrush x:Key="gradientBTextStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="White" Offset="0" />
            <GradientStop Color="WhiteSmoke" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="gradientBG2Style" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="LightSlateGray" Offset="0" />
            <GradientStop Color="CornflowerBlue" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="gradientBGStyle" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="DarkCyan" Offset="0" />
            <GradientStop Color="#007474" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>
</Application>
